# Live site URL (optional — auto-detected from public/CNAME or GITHUB_REPOSITORY in CI).
NEXT_PUBLIC_SITE_URL=https://busydadtraining.com

# Optional: override auto-detected GitHub Pages base path.
# Leave empty (or unset) for custom domains and username.github.io root repos.
# NEXT_PUBLIC_BASE_PATH=

# Listmonk newsletter (public subscription API — safe to expose in the browser).
# UUID of the "BusyDadTraining" list (id 3).
NEXT_PUBLIC_LISTMONK_URL=https://mail.busydadtraining.com
NEXT_PUBLIC_LISTMONK_LIST_UUID=ab776f98-a8ae-4e1b-9958-47d4deeefe3d

# Live burpee counter — anonymous SignalR hub on the app API.
NEXT_PUBLIC_BURPEE_HUB_URL=https://api.busydadtraining.com/hubs/burpees

# Live community leaderboard — anonymous SignalR hub on the app API.
NEXT_PUBLIC_LEADERBOARD_HUB_URL=https://api.busydadtraining.com/hubs/leaderboard
